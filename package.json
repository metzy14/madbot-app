{
  "name": "madbot",
  "productName": "MadBot",
  "version": "1.1.0",
  "private": true,
  "description": "Self-contained MadBot control room for alerts, overlays, lights, and voice.",
  "main": "src/main.js",
  "author": "MaddogMetzy",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir --x64"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "gg.thedogkennel.madbot",
    "productName": "MadBot",
    "icon": "build/icon.png",
    "directories": { "output": "dist" },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "overlays/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "engine", "to": "engine" }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": ["dir"],
      "signAndEditExecutable": false,
      "artifactName": "MadBot.${ext}"
    }
  }
}
